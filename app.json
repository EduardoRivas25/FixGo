{
  "expo": {
    "name": "FixGo",
    "slug": "fixgo",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "scheme": "fixgo",
    "plugins": [
      "expo-router",
      [
        "expo-image-picker",
        {
          "photosPermission": "FixGo accede a tus fotos para adjuntarlas a una solicitud de reparación.",
          "cameraPermission": false,
          "microphonePermission": false
        }
      ],
      "expo-font"
    ],
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "bundler": "metro"
    }
  }
}
